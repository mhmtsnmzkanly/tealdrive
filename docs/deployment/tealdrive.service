[Unit]
Description=TealDrive file manager
After=network.target

[Service]
Type=simple
User=tealdrive
Group=tealdrive
WorkingDirectory=/home/tealdrive/data/runtime
ExecStart=/home/tealdrive/bin/tealdrive-server --config /home/tealdrive/policy/server.toml --runtime-config /home/tealdrive/config/settings.toml --helper-bin /home/tealdrive/bin/tealdrive-helper
Restart=on-failure
RestartSec=3
UMask=0077
# SIGTERM goes to the server first so helper operations can drain.
# systemd still kills the entire control group if shutdown exceeds this deadline.
KillMode=mixed
TimeoutStopSec=45s
# Required for the dedicated setuid helper. The server itself refuses root.
# Do not enable NoNewPrivileges, a nosuid filesystem, or a restrictive capability
# bounding set: these would prevent PAM/UID switching in the helper.
# The helper sets no_new_privs itself AFTER permanently dropping all three IDs.

[Install]
WantedBy=multi-user.target
